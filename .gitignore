.venv/
__pycache__/
*.py[cod]
.env

# Data is regenerable from providers and far too large for git.
data/db/*.duckdb
data/db/*.wal
data/raw/
reports/*.csv
# Regenerated by every nightly run: the log grows and the payload is rewritten,
# so tracking them means the same diff every morning. Both rebuild from the
# pipeline -- /api/today returns a 503 naming the command if the payload is
# missing.
reports/*.log
reports/today.json
# Built by scripts/build_demo_page.py from app/demo/home_demo.template.html,
# which IS tracked. The template is the source; this is the render.
reports/home_demo.html

app/node_modules/
app/dist/
.DS_Store
Thumbs.db

# Portfolio state is yours and irreplaceable - back it up, do not commit it.
data/db/portfolio.duckdb
data/db/portfolio.duckdb.wal
# Its backups are the same irreplaceable data, and just as unwelcome in git.
data/backups/
